# Copy this file to .env for local development, then fill private values locally.
# Never put real credentials in this file, README, GitHub, or chat.
# Production values belong in the existing Railway service's Variables (only after approval).

# Required
BOT_TOKEN=
DATABASE_URL=

# Required Telegram webhook settings. Use the complete public HTTPS endpoint and a private random secret.
WEBHOOK_URL=https://YOUR-PUBLIC-DOMAIN/telegram/webhook
WEBHOOK_SECRET=
# Railway provides PORT automatically. 3000 is the local default.
PORT=3000

# PostgreSQL connection pool (optional; default 8)
DB_POOL_MAX=8

# General AI routing. Cross-provider fallback is opt-in for general requests.
AI_PROVIDER=openai
AI_FALLBACK_ENABLED=false
AI_TIMEOUT_MS=20000
GEMINI_TIMEOUT_MS=45000
OPENAI_MODEL=gpt-6-luna
GEMINI_MODEL=gemini-3.8-flash

# OpenAI: up to three keys; unused slots may remain blank.
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# Gemini: use GEMINI_API_KEY or GEMINI_API_KEY_1 for slot 1, not both.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Groq: optional provider/fallback keys and model IDs.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL_2=qwen/qwen3.8-27b

# ScraperAPI: optional. Each configured key may consume paid credits.
SCRAPER_API_KEY=
SCRAPER_API_KEY_2=
# Scheduled deal newsletters are disabled by default to protect paid ScraperAPI credits; set true only after approval.
DEALS_SCHEDULER_ENABLED=false

# Weather bulletins at 11:00 and 20:00 Cairo time; set false to pause.
WEATHER_SCHEDULER_ENABLED=true

# Optional operational settings
LOG_CHAT_ID=
# Comma-separated Telegram user IDs allowed to review price records, besides the built-in master ID.
OWNER_ID=
# Optional formula reference channel URL for chemical-assistant replies.
FORMULA_CHANNEL_URL=
# Legacy read-only live-preflight target; scheduled publishing uses active authorized_chats.
DEALS_CHAT_ID=
