# التشغيل webhook فقط. لا يوجد polling في هذه النسخة.
# يكفي WEBHOOK_URL، أو اتركه فارغًا إذا كان Railway يضبط RAILWAY_PUBLIC_DOMAIN تلقائيًا بعد Public Networking.
# مثال: https://your-app.up.railway.app — المسار النهائي دائمًا /telegram/webhook ولا يُكرَّر إن كتبته.
WEBHOOK_URL=
# أحرف إنجليزية وأرقام و _ و - فقط، و8 خانات على الأقل. المسافات والرموز تُحذف؛ إن بقي أقل من 8 يُسجَّل الاستقبال بلا سر.
WEBHOOK_SECRET=
# الحذف التلقائي للرسائل المزعجة يبقى متوقفًا. لا تضبطه true إلا بعد مراجعة السجلات وصلاحية الحذف.
PROTECTION_ENFORCE=false

