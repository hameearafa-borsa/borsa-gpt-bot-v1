# Required: public HTTPS URL including a dedicated path, e.g. https://your-service.up.railway.app/telegram/webhook
WEBHOOK_URL=
# Required: 1-256 chars from A-Z, a-z, 0-9, underscore, hyphen. Do not share this secret.
WEBHOOK_SECRET=
# Railway provides PORT automatically; local default is 3000.
PORT=3000

# AI routing: OpenAI is the primary provider by default; cross-provider fallback is opt-in.
AI_PROVIDER=openai
AI_FALLBACK_ENABLED=false
# OpenAI rejects temperature on this key and these models. The client never sends it.
OPENAI_MODEL=gpt-6-luna
# Working Gemini models, tried in order when the chosen id is missing: gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash.
# Gemini 3 also rejects temperature, top_p, and top_k.
GEMINI_MODEL=gemini-3.8-flash
XAI_MODEL=grok-4.7
# Set keys only in the private .env / Railway Variables; never commit real values.
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
XAI_API_KEY=
XAI_API_KEY_2=
SCRAPER_API_KEY=
LOG_CHAT_ID=
DEALS_CHAT_ID=
PROTECTION_ENFORCE=false
