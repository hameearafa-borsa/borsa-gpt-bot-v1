# Telegram
BOT_TOKEN=
OWNER_ID=
ADMIN_ID=
DESIGNATED_ADMIN_ID=
ALLOWED_CHAT_IDS=
DEALS_CHAT_ID=
LOG_CHAT_ID=
LOG_CHANNEL_ID=
FORMULA_CHANNEL_URL=

# Database
DATABASE_URL=
DB_POOL_MAX=8

# OpenAI
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_MODEL=gpt-6-luna

# xAI
XAI_API_KEY=
XAI_API_KEY_2=
XAI_MODEL=grok-4.7

# Google Gemini
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# AI request timeout in milliseconds
AI_TIMEOUT_MS=20000

# Optional deal-source scraping
SCRAPER_API_KEY=

# Optional image inspection / moderation provider
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# Protection settings
PROTECTION_ENFORCE=
PROTECTION_DAILY_PHOTO_LIMIT=
PROTECTION_DAILY_VIDEO_LIMIT=
PROTECTION_RATE_LIMIT=
PROTECTION_RATE_WINDOW_MS=

# Telegram Webhook
# Use your public HTTPS service URL with a dedicated path.
# Example: https://your-service.up.railway.app/telegram/webhook
WEBHOOK_URL=

# Use a random secret containing only letters, numbers, "_" or "-".
# Never share the real secret.
WEBHOOK_SECRET=

# Railway supplies PORT automatically; local default is 3000.
PORT=3000
