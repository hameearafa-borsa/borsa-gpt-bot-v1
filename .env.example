# Required: public HTTPS URL including a dedicated path, e.g. https://your-service.up.railway.app/telegram/webhook
WEBHOOK_URL=
# Required: 1-256 chars from A-Z, a-z, 0-9, underscore, hyphen. Do not share this secret.
WEBHOOK_SECRET=
# Railway provides PORT automatically; local default is 3000.
PORT=3000

# AI routing: OpenAI is the primary provider by default; cross-provider fallback is opt-in.
AI_PROVIDER=openai
AI_FALLBACK_ENABLED=false
# Per-request timeout for OpenAI/Groq in milliseconds; keep 20000 ms unless diagnostics justify changing it.
AI_TIMEOUT_MS=20000
# Gemini gets more time for complex answers; this does not shorten or bypass model safety checks.
GEMINI_TIMEOUT_MS=45000
OPENAI_MODEL=gpt-6-luna
GEMINI_MODEL=gemini-3.8-flash
# Set keys only in the private .env / Railway Variables; never commit real values.
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Groq fallback for the chemical assistant; model IDs can be switched without code changes.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MODEL_2=qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_API_KEY_2=
SCRAPER_API_KEY=
SCRAPER_API_KEY_2=
# Paid automatic deal scraping is disabled unless deliberately enabled after review.
DEALS_SCHEDULER_ENABLED=false
# Manual ScraperAPI test can spend credits; leave disabled unless intentionally testing.
ENABLE_SCRAPER_TEST=false
LOG_CHAT_ID=
# Comma-separated Telegram user IDs allowed to review price records, in addition to the built-in master ID.
OWNER_ID=
# Legacy single-group variable; deal/catalog schedulers now target active authorized_chats.
DEALS_CHAT_ID=
